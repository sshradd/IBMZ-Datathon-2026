VITE_MAPBOX_TOKEN=
VITE_LIVE_REFRESH_MS=300000

# Twilio credentials stay on the API server. Do not prefix them with VITE_.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM=
API_PORT=8787
ALLOWED_ORIGIN=http://localhost:5173

# Required only when sending a PDF. The URL must be reachable by the recipient's phone.
PUBLIC_BASE_URL=https://your-public-api.example.com
